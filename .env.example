# Copy to .env (git-ignored). Values for a local Android emulator.
APP_NAME="My Demo App"
APP_SLUG=mydemoapp
APP_TYPE=native
APP_PATH=builds/mydemoapp-2.3.0-27.apk
APP_PACKAGE=com.saucelabs.mydemoapp.android
APP_ACTIVITY=
PLATFORM_NAME=Android
DEVICE_NAME=emulator-5554
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723
# Fail the run at start-up if less memory than this is available (MB).
MIN_AVAILABLE_MEMORY_MB=2048
# My Demo App's built-in demo account (shown on its own login screen).
TEST_USERNAME=
TEST_PASSWORD=
